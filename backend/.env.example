# SOMAK AI Environment Configuration Template
# Duplicate to .env and configure secret parameters

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# AI Model Inference (Nebius Token Factory / NVIDIA NIM)
NEBIUS_API_KEY=your_nebius_api_key_here

# Diagnostic Search Grounding (Tavily Search API)
TAVILY_API_KEY=your_tavily_api_key_here

# Sentry Webhook HMAC-SHA256 Secret (Used to verify sentry-hook-signature header)
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_signing_secret_here

# Session Cryptographic Signing Secret
SESSION_SECRET=generate_with_python_secrets_token_hex_32

# Master Envelope Encryption Key for Third-Party Secrets at Rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=G1U6pM5N1D-9Bw_l1iK8m4o2P3q4R5s6T7u8V9w0X1Y=

# MFA Configuration
MFA_ISSUER_NAME=SOMAK AI

# Security Policy Configuration
COOKIE_SECURE=false
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900
SANDBOX_TIMEOUT_SECONDS=10

# Dodo Payments (Merchant of Record)
# API key from https://dashboard.dodopayments.com
DODO_API_KEY=your_dodo_api_key_here
DODO_WEBHOOK_SECRET=your_dodo_webhook_signing_secret_here
